#api call for signup-creating user account
###
POST http://127.0.0.1:8000/nutrition/signup/
Content-Type: application/json

{
    "username":"tom",
    "email":"tom@gmail.com",
    "password":"tom@123"
}


#api call for get current user detail
###
GET http://127.0.0.1:8000/nutrition/me/
Accept: application/json
Authorization: Basic rameesa:rameesa@123


#api call to get token -token generation
###
POST http://127.0.0.1:8000/nutrition/token/
Content-Type: application/json

{
    "username":"rameesa",
    "password":"rameesa@123"
}



# rameesa ---> "token": "fda45c0897d0344e5d2701356e89507f7f9a4db0"
# tom ---> "token": "2b7fcfe954babc011a686b2d52129e74c670b7d6"




 #  ================FOOD LOG API CALLS==========================


